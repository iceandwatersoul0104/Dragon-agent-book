# 环境变量样例。复制成 .env 后填写——.env 不进版本库（.dockerignore 已排除）。
#
# 分两类：
#   - **非密配置**：可以进配置中心 / ConfigMap，改动代价是滚动更新；
#   - **密钥**：只进密钥管理系统，运行时注入，不落版本库、不进日志。
#
# 本工程的读取路径：
#   LLM_API_KEY / OPENAI_API_KEY / LLM_BASE_URL / LLM_MODEL  →  dragon_agent/config.py
#   DRAGON_* 成本护栏档位                                     →  dragon_agent/cli.py

# ---------------------------------------------------------------- 密钥（不进版本库）
# 模型服务商的 API Key。自建服务用 LLM_BASE_URL 指地址，OPENAI_API_KEY 同样有效。
LLM_API_KEY=

# ---------------------------------------------------------------- 非密配置
# 模型标识。留空则用 mock-model（离线模式，不需要 key）。
LLM_MODEL=mock-model

# 模型服务地址与路径前缀。
LLM_BASE_URL=https://api.openai.com/v1

# 工作目录与 trace 输出目录。容器里对应挂载点。
DRAGON_WORKSPACE=/workspace
DRAGON_TRACE_DIR=/workspace/traces

# ---------------------------------------------------------------- 成本护栏档位
# 优先级：命令行开关 > 环境变量 > 内置默认值。
#
# 预算告警线：成本花到这个比例时告警。
DRAGON_WARN_RATIO=0.8
# 降级线：花到这个比例时降级模型，同时是自动熔断的触发线。
DRAGON_DEGRADE_RATIO=0.9
# 连续失败多少次后熔断打开。
DRAGON_BREAKER_THRESHOLD=3
# 模型侧限流：每秒请求数。
DRAGON_MODEL_RPS=5
# 工具侧并发上限。
DRAGON_TOOL_CONCURRENCY=4
# 队列容量（背压）。
DRAGON_QUEUE_CAPACITY=32

# ---------------------------------------------------------------- 运行期行为
# 不缓冲输出：容器被 kill 时最后几行日志不会丢。
PYTHONUNBUFFERED=1
